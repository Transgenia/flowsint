{
  "name": "a-hosting-ip",
  "raw_from_list": {
    "category": "Domain",
    "id": "5dcc5f21-cf73-4688-b938-3cd24b605e4b",
    "content": {
      "name": "a-hosting-ip",
      "description": "Resuelve los registros A de un dominio y devuelve cada IP como Ip (revela hosting/CDN, ej. Cloudflare/Shopify)",
      "category": "Domain",
      "version": 1,
      "input": {
        "type": "Domain",
        "key": "domain"
      },
      "request": {
        "method": "GET",
        "url": "https://networkcalc.com/api/dns/lookup/{{domain}}",
        "headers": {
          "Accept": "application/json",
          "User-Agent": "flowsint-enricher"
        },
        "timeout": 20
      },
      "response": {
        "expect": "json",
        "map": {
          "address": "address"
        }
      },
      "output": {
        "type": "Ip",
        "is_array": true,
        "array_path": "records.A"
      },
      "retry": {
        "max_retries": 3,
        "backoff_factor": 1,
        "retry_on_status": [
          429,
          500,
          502,
          503,
          504
        ]
      }
    },
    "owner_id": "fff68b9f-f430-4b0c-adc0-19708decb2d8",
    "updated_at": "2026-08-01T06:33:38.563382+00:00",
